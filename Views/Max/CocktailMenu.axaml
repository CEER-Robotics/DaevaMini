<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:DaevaMini.Converters"
             xmlns:models="clr-namespace:DaevaMini.Models"
             xmlns:vm="clr-namespace:DaevaMini.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="DaevaMini.Views.Max.CocktailMenu"
             x:Name="MenuHost"
             x:DataType="vm:CocktailMenuViewModel">

    <UserControl.Resources>
        <converters:BitmapAssetConverter x:Key="BitmapAssetConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto, *" Background="#121212">

        <Grid Grid.Row="0" Height="120">
            <Border Width="800" Height="90"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    CornerRadius="0,0,45,45">
                <Image Source="avares://Daeva/Assets/logo_white.png"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="5"/>
            </Border>
            
            <Button Name="BackButton"
                    Width="60" Height="60"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Margin="30,20,0,0"
                    Background="Transparent"
                    Cursor="Hand">
                <PathIcon Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                          Foreground="White"
                          Width="35" Height="35"/>
            </Button>
        </Grid>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Cocktails}" Margin="40,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" Rows="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Cocktail">
                    <Button Margin="15" Padding="0" CornerRadius="15" Background="#253540"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            IsEnabled="{Binding IsActive}"
                            Command="{Binding DataContext.SelectCocktailCommand, ElementName=MenuHost}"
                            CommandParameter="{Binding}">
                        <Button.Styles>
                            <!-- Suppress Avalonia's default disabled opacity — we handle it via overlay -->
                            <Style Selector="Button:disabled">
                                <Setter Property="Opacity" Value="1"/>
                            </Style>
                        </Button.Styles>
                        <Grid RowDefinitions="*, Auto">
                            <Image Grid.Row="0" Source="{Binding ImageSource, Converter={StaticResource BitmapAssetConverter}}"
                                   Margin="20" Stretch="Uniform"/>
                            <Border Grid.Row="1" Background="{Binding CardBackground}" Height="60"
                                    CornerRadius="0,0,15,15">
                                <TextBlock Text="{Binding Title}" Foreground="Black" FontWeight="Bold"
                                           FontSize="30" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <!-- Inactive overlay — rendered on top, covers both rows -->
                            <Border Grid.RowSpan="2" Background="#BB121212" CornerRadius="15"
                                    IsVisible="{Binding IsInactive}"/>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>