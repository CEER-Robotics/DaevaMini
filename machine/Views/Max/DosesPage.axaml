<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:max="clr-namespace:DaevaMini.Views.Max"
             xmlns:controls="clr-namespace:DaevaMini.Controls"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="DaevaMini.Views.Max.DosesPage"
             x:Name="PageHost">

    <UserControl.Styles>
        <Style Selector="Button.InvisibleBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.InvisibleBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.PickBtn">
            <Setter Property="Background" Value="#0CFFFFFF"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="22,0"/>
        </Style>
        <Style Selector="Button.PickBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>

        <Style Selector="Button.StepBtn">
            <Setter Property="Background" Value="#1F211C"/>
            <Setter Property="BorderBrush" Value="#3A3D33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.StepBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A3030"/>
        </Style>

        <!-- Switches a drink on and off. A disabled drink stays on the menu but loses
             its pour button, so this reads as "orderable" rather than "listed". -->
        <Style Selector="Button.ToggleBtn">
            <Setter Property="Background" Value="#141712"/>
            <Setter Property="BorderBrush" Value="#3A3D33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ToggleBtn.on">
            <Setter Property="Background" Value="#16301F"/>
            <Setter Property="BorderBrush" Value="#3FBF7F"/>
        </Style>

    </UserControl.Styles>

    <Canvas Width="1920" Height="1080">
        <Canvas.Background>
            <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="80%" RadiusY="80%">
                <GradientStop Color="#1A2222" Offset="0"/>
                <GradientStop Color="#0B0D0D" Offset="1"/>
            </RadialGradientBrush>
        </Canvas.Background>

        <Button Canvas.Left="60" Canvas.Top="40" Classes="InvisibleBtn" Click="OnBackClick" Width="240" Height="48">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <PathIcon Width="22" Height="22" Foreground="{StaticResource TextPrimary}"
                          Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
                <TextBlock Text="INDIETRO" Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FontBody}" FontFamily="Space Grotesk"
                           FontWeight="Bold" VerticalAlignment="Center" LetterSpacing="1"/>
            </StackPanel>
        </Button>

        <TextBlock Canvas.Top="40" Width="1920" Text="DOSI DEI COCKTAIL" Foreground="{StaticResource TextPrimary}"
                   FontSize="{StaticResource FontSection}" FontWeight="Bold" FontFamily="Space Grotesk"
                   TextAlignment="Center" LetterSpacing="3"/>

        <TextBlock Canvas.Top="88" Width="1920"
                   Text="Scegli un cocktail e regola i millilitri di ogni ingrediente. Le modifiche valgono da subito."
                   Foreground="{StaticResource TextMuted}" FontSize="{StaticResource FontBody}" FontFamily="Space Grotesk" TextAlignment="Center"/>

        <!-- cocktail list -->
        <Border Canvas.Left="150" Canvas.Top="150" Width="560" Height="830" CornerRadius="32"
                Background="#0AFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" Padding="22">
            <!-- Dragged with a finger, not with the scrollbar. The bar is left on its
                 default auto-hiding behaviour, so it only shows up briefly while the
                 list is moving and is not sitting there the rest of the time.
                 Horizontal scrolling is off so the buttons size to the viewport. -->
            <ScrollViewer controls:DragScroll.Enabled="True"
                          HorizontalScrollBarVisibility="Disabled">
                <!-- Right margin keeps the ON/OFF pill clear of the scrollbar, which
                     floats over the content rather than taking a column of its own. -->
                <ItemsControl ItemsSource="{Binding Cocktails, ElementName=PageHost}"
                              Margin="0,0,18,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="max:DoseCocktail">
                            <!-- The on/off pill is a sibling of the select button, not a
                                 button inside a button: nesting would have made one tap
                                 both toggle the drink and select it. -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <Button Grid.Column="0" Classes="PickBtn" Height="72"
                                        HorizontalAlignment="Stretch"
                                        Opacity="{Binding RowOpacity}"
                                        Click="OnSelectCocktail" CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   Foreground="{Binding NameBrush}" FontSize="{StaticResource FontLabel}" FontWeight="Bold"
                                                   FontFamily="Space Grotesk" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- Kept clear of the name: long names used to run
                                             straight into the millilitres. -->
                                        <TextBlock Grid.Column="1" Text="{Binding TotalLabel}"
                                                   Margin="24,0,0,0"
                                                   Foreground="{StaticResource TextMuted}" FontSize="{StaticResource FontBody}"
                                                   FontFamily="Space Grotesk" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <Button Grid.Column="1" Classes="ToggleBtn"
                                        Classes.on="{Binding IsActive}"
                                        Width="86" Height="72" Margin="10,0,0,0"
                                        Click="OnToggleActive" CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding ActiveLabel}"
                                               Foreground="{Binding ActiveBrush}"
                                               FontSize="{StaticResource FontBody}" FontWeight="Bold"
                                               FontFamily="Space Grotesk"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ingredients of the selected cocktail -->
        <Border Canvas.Left="750" Canvas.Top="150" Width="1020" Height="830" CornerRadius="32"
                Background="#0AFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" Padding="36,28">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,24">
                    <TextBlock Name="SelectedName" Text=""
                               Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FontSection}" FontWeight="Bold"
                               FontFamily="Space Grotesk"/>
                    <TextBlock Name="SelectedTotal" Text=""
                               Foreground="{StaticResource Accent}" FontSize="{StaticResource FontBody}"
                               FontFamily="Space Grotesk"/>
                </StackPanel>

                <!-- Same treatment: it is the same defect on the same page. -->
                <ScrollViewer controls:DragScroll.Enabled="True"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Ingredients, ElementName=PageHost}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="max:DoseIngredient">
                                <Border Height="96" CornerRadius="20" Background="#0CFFFFFF"
                                        Padding="30,0" Margin="0,0,0,12">
                                    <Grid ColumnDefinitions="*,200,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FontTitle}" FontWeight="Medium"
                                                   FontFamily="Space Grotesk" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1" Text="{Binding AmountLabel}"
                                                   Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FontTitle}" FontWeight="Bold"
                                                   FontFamily="Space Grotesk" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14"
                                                    VerticalAlignment="Center">
                                            <Button Classes="StepBtn" Width="52" Height="52"
                                                    Click="OnDecreaseClick" CommandParameter="{Binding}">
                                                <TextBlock Text="-" Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FontSection}" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Classes="StepBtn" Width="52" Height="52"
                                                    Click="OnIncreaseClick" CommandParameter="{Binding}">
                                                <TextBlock Text="+" Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FontSection}" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <TextBlock Name="StatusLine"
                   Canvas.Top="1000" Width="1920" Text=""
                   Foreground="{StaticResource Accent}" FontSize="{StaticResource FontBody}" FontFamily="Space Grotesk" TextAlignment="Center"/>
    </Canvas>
</UserControl>
