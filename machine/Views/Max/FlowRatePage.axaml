<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:max="clr-namespace:DaevaMini.Views.Max"
             xmlns:controls="clr-namespace:DaevaMini.Controls"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="DaevaMini.Views.Max.FlowRatePage"
             x:Name="PageHost">

    <UserControl.Styles>
        <Style Selector="Button.InvisibleBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.InvisibleBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.StepBtn">
            <Setter Property="Background" Value="#1F211C"/>
            <Setter Property="BorderBrush" Value="#3A3D33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.StepBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A3030"/>
        </Style>

        <!-- The one action on each row, so there is never a question of what to press. -->
        <Style Selector="Button.TestBtn">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.TestBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3DFFFFFF"/>
        </Style>
        <Style Selector="Button.TestBtn:disabled">
            <Setter Property="Opacity" Value="0.3"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>

        <Style Selector="Button.PrimaryBtn">
            <Setter Property="Height" Value="96"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#16301F"/>
            <Setter Property="BorderBrush" Value="#3FBF7F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.PrimaryBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1D4029"/>
        </Style>
        <Style Selector="Button.PrimaryBtn:disabled">
            <Setter Property="Opacity" Value="0.35"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>

        <Style Selector="Button.GhostBtn">
            <Setter Property="Height" Value="96"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#0CFFFFFF"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.GhostBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>

        <Style Selector="Button.PadBtn">
            <Setter Property="Background" Value="#171A14"/>
            <Setter Property="BorderBrush" Value="#2E322A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.PadBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A3030"/>
        </Style>

        <Style Selector="TextBlock.PadDigit">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSection}"/>
            <Setter Property="FontFamily" Value="Space Grotesk"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="TextBlock.StepTitle">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="{StaticResource FontScreen}"/>
            <Setter Property="FontFamily" Value="Space Grotesk"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.StepBody">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="{StaticResource FontTitle}"/>
            <Setter Property="FontFamily" Value="Space Grotesk"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <Canvas Width="1920" Height="1080">
        <Canvas.Background>
            <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="80%" RadiusY="80%">
                <GradientStop Color="#1A2222" Offset="0"/>
                <GradientStop Color="#0B0D0D" Offset="1"/>
            </RadialGradientBrush>
        </Canvas.Background>

        <Button Canvas.Left="60" Canvas.Top="40" Classes="InvisibleBtn" Click="OnBackClick" Width="220" Height="48">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <PathIcon Width="22" Height="22" Foreground="{StaticResource TextPrimary}"
                          Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
                <TextBlock Text="INDIETRO" Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FontBody}" FontFamily="Space Grotesk"
                           FontWeight="Bold" VerticalAlignment="Center" LetterSpacing="1"/>
            </StackPanel>
        </Button>

        <TextBlock Canvas.Top="40" Width="1920" Text="VELOCITÀ DEI FUSTI" Foreground="{StaticResource TextPrimary}"
                   FontSize="{StaticResource FontSection}" FontWeight="Bold" FontFamily="Space Grotesk"
                   TextAlignment="Center" LetterSpacing="3"/>

        <TextBlock Canvas.Top="88" Width="1920"
                   Text="Ogni fusto versa a una velocità diversa. Misurala una volta e i cocktail verranno giusti."
                   Foreground="{StaticResource TextMuted}" FontSize="{StaticResource FontBody}"
                   FontFamily="Space Grotesk" TextAlignment="Center"/>

        <!-- Kegs off: measuring would pour against a closed valve. -->
        <Border Canvas.Left="360" Canvas.Top="140" Width="1200" Height="70" CornerRadius="20"
                Background="#141008" BorderBrush="#5A4A16" BorderThickness="1"
                IsVisible="{Binding AreKegsOff, ElementName=PageHost}">
            <TextBlock Text="I fusti sono spenti. Accendi &quot;Attiva fusti&quot; nelle impostazioni per poterli misurare."
                       Foreground="{StaticResource Warning}" FontSize="{StaticResource FontBody}"
                       FontFamily="Space Grotesk" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Border Canvas.Left="260" Canvas.Top="230" Width="1400" Height="720" CornerRadius="32"
                Background="#0AFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" Padding="34,28">
            <Grid>
                <TextBlock IsVisible="{Binding IsEmpty, ElementName=PageHost}"
                           Text="Nessun fusto configurato. Assegna un liquido a un fusto in &quot;Selezione liquidi&quot;."
                           Foreground="{StaticResource TextMuted}" FontSize="{StaticResource FontTitle}"
                           FontFamily="Space Grotesk" TextAlignment="Center" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="60,0"/>

                <!-- Dragged with a finger like the other lists; see Controls/DragScroll.cs. -->
                <ScrollViewer controls:DragScroll.Enabled="True" HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding HasLines, ElementName=PageHost}">
                    <ItemsControl ItemsSource="{Binding Lines, ElementName=PageHost}" Margin="0,0,14,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="max:LineFlowRate">
                                <Border Height="120" CornerRadius="22" Background="#0CFFFFFF" Padding="30,0" Margin="0,0,0,14">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="14">
                                                <TextBlock Text="{Binding Liquid}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontSize="{StaticResource FontTitle}" FontWeight="Bold"
                                                           FontFamily="Space Grotesk" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ChannelLabel}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="{StaticResource FontCaption}"
                                                           FontFamily="Space Grotesk" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- The rate in something you can picture, not in mL/s. -->
                                            <TextBlock Text="{Binding PlainRate}"
                                                       Foreground="{StaticResource Accent}"
                                                       FontSize="{StaticResource FontBody}" FontWeight="Bold"
                                                       FontFamily="Space Grotesk"/>
                                            <TextBlock Text="{Binding SourceLabel}"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontSize="{StaticResource FontCaption}"
                                                       FontFamily="Space Grotesk"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Classes="TestBtn" Width="230" Height="66"
                                                IsEnabled="{Binding CanMeasure, ElementName=PageHost}"
                                                Click="OnMeasureClick" CommandParameter="{Binding}">
                                            <TextBlock Text="MISURA" Foreground="{StaticResource TextPrimary}"
                                                       FontSize="{StaticResource FontBody}" FontWeight="Bold"
                                                       FontFamily="Space Grotesk" LetterSpacing="1"/>
                                        </Button>

                                        <Button Grid.Column="2" Classes="StepBtn" Width="190" Height="66" Margin="12,0,0,0"
                                                IsVisible="{Binding IsMeasured}"
                                                Click="OnResetClick" CommandParameter="{Binding}">
                                            <TextBlock Text="RIPRISTINA" Foreground="{StaticResource TextMuted}"
                                                       FontSize="{StaticResource FontCaption}" FontWeight="Bold"
                                                       FontFamily="Space Grotesk"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Name="StatusLine"
                   Canvas.Top="980" Width="1920" Text=""
                   Foreground="{StaticResource Accent}" FontSize="{StaticResource FontBody}"
                   FontFamily="Space Grotesk" TextAlignment="Center"/>

        <!-- The guided measurement: one question per screen, and the machine does the sums. -->
        <Border Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080"
                Background="#F00B0D0D"
                IsVisible="{Binding IsWizardOpen, ElementName=PageHost}">
            <Border Width="1240" Height="820" CornerRadius="40" Background="#12140F"
                    BorderBrush="#20FFFFFF" BorderThickness="1" Padding="50"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <!-- Step 1: what to do before pouring. -->
                    <StackPanel IsVisible="{Binding IsReady, ElementName=PageHost}"
                                VerticalAlignment="Center" Spacing="30">
                        <TextBlock Text="{Binding WizardTitle, ElementName=PageHost}"
                                   Foreground="{StaticResource Accent}" FontSize="{StaticResource FontTitle}"
                                   FontWeight="Bold" FontFamily="Space Grotesk" TextAlignment="Center"/>
                        <TextBlock Classes="StepTitle" Text="Metti un bicchiere vuoto sotto questo fusto"/>
                        <TextBlock Classes="StepBody"
                                   Text="Quando premi, il fusto versa per 10 secondi. Raccogli tutto il liquido: fra poco ti chiedo quanto ne è uscito."/>
                        <Grid ColumnDefinitions="*,20,*" Margin="0,20,0,0">
                            <Button Grid.Column="0" Classes="GhostBtn" Click="OnCancelWizard">
                                <TextBlock Text="ANNULLA" Foreground="{StaticResource TextMuted}"
                                           FontSize="{StaticResource FontBody}" FontWeight="Bold"
                                           FontFamily="Space Grotesk"/>
                            </Button>
                            <Button Grid.Column="2" Classes="PrimaryBtn" Click="OnStartPourClick">
                                <TextBlock Text="VERSA" Foreground="{StaticResource TextPrimary}"
                                           FontSize="{StaticResource FontBody}" FontWeight="Bold"
                                           FontFamily="Space Grotesk" LetterSpacing="2"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Step 2: pouring, with the seconds counting down. -->
                    <StackPanel IsVisible="{Binding IsPouring, ElementName=PageHost}"
                                VerticalAlignment="Center" Spacing="24">
                        <TextBlock Classes="StepTitle" Text="Sta versando"/>
                        <TextBlock Text="{Binding CountdownLabel, ElementName=PageHost}"
                                   Foreground="{StaticResource Accent}" FontSize="{StaticResource FontHero}"
                                   FontWeight="Bold" FontFamily="Space Grotesk" TextAlignment="Center"/>
                        <TextBlock Classes="StepBody" Text="Non togliere il bicchiere finché non finisce."/>
                    </StackPanel>

                    <!-- Step 3: the only number anyone has to give, in the unit on the glass. -->
                    <Grid IsVisible="{Binding IsAsking, ElementName=PageHost}"
                          ColumnDefinitions="*,40,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="22">
                            <TextBlock Classes="StepTitle" Text="Quanti ml hai raccolto?"/>
                            <TextBlock Classes="StepBody"
                                       Text="Leggi la misura sul bicchiere graduato. Se lo pesi, un grammo vale un millilitro."/>
                            <Border Background="#0CFFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                    CornerRadius="20" Height="120" Margin="20,10">
                                <StackPanel Orientation="Horizontal" Spacing="14"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CollectedLabel, ElementName=PageHost}"
                                               Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FontHero}"
                                               FontWeight="Bold" FontFamily="Space Grotesk"/>
                                    <TextBlock Text="ml" Foreground="{StaticResource TextMuted}"
                                               FontSize="{StaticResource FontTitle}" FontFamily="Space Grotesk"
                                               VerticalAlignment="Bottom" Margin="0,0,0,16"/>
                                </StackPanel>
                            </Border>
                            <Grid ColumnDefinitions="*,20,*">
                                <Button Grid.Column="0" Classes="GhostBtn" Click="OnCancelWizard">
                                    <TextBlock Text="ANNULLA" Foreground="{StaticResource TextMuted}"
                                               FontSize="{StaticResource FontBody}" FontWeight="Bold"
                                               FontFamily="Space Grotesk"/>
                                </Button>
                                <Button Grid.Column="2" Classes="PrimaryBtn" Click="OnConfirmAmountClick"
                                        IsEnabled="{Binding CanConfirm, ElementName=PageHost}">
                                    <TextBlock Text="CONFERMA" Foreground="{StaticResource TextPrimary}"
                                               FontSize="{StaticResource FontBody}" FontWeight="Bold"
                                               FontFamily="Space Grotesk" LetterSpacing="1"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <UniformGrid Grid.Column="2" Columns="3" Rows="4" Width="420" Height="560"
                                     VerticalAlignment="Center">
                            <Button Classes="PadBtn" Tag="1" Click="OnDigitClick"><TextBlock Classes="PadDigit" Text="1"/></Button>
                            <Button Classes="PadBtn" Tag="2" Click="OnDigitClick"><TextBlock Classes="PadDigit" Text="2"/></Button>
                            <Button Classes="PadBtn" Tag="3" Click="OnDigitClick"><TextBlock Classes="PadDigit" Text="3"/></Button>
                            <Button Classes="PadBtn" Tag="4" Click="OnDigitClick"><TextBlock Classes="PadDigit" Text="4"/></Button>
                            <Button Classes="PadBtn" Tag="5" Click="OnDigitClick"><TextBlock Classes="PadDigit" Text="5"/></Button>
                            <Button Classes="PadBtn" Tag="6" Click="OnDigitClick"><TextBlock Classes="PadDigit" Text="6"/></Button>
                            <Button Classes="PadBtn" Tag="7" Click="OnDigitClick"><TextBlock Classes="PadDigit" Text="7"/></Button>
                            <Button Classes="PadBtn" Tag="8" Click="OnDigitClick"><TextBlock Classes="PadDigit" Text="8"/></Button>
                            <Button Classes="PadBtn" Tag="9" Click="OnDigitClick"><TextBlock Classes="PadDigit" Text="9"/></Button>
                            <Button Classes="PadBtn" IsEnabled="False" Opacity="0"><TextBlock Classes="PadDigit" Text=""/></Button>
                            <Button Classes="PadBtn" Tag="0" Click="OnDigitClick"><TextBlock Classes="PadDigit" Text="0"/></Button>
                            <Button Classes="PadBtn" Click="OnDigitBackspace">
                                <PathIcon Width="30" Height="30" Foreground="{StaticResource TextPrimary}"
                                          Data="M22,3H7C6.31,3 5.77,3.35 5.41,3.88L0,12L5.41,20.11C5.77,20.64 6.31,21 7,21H22A2,2 0 0,0 24,19V5A2,2 0 0,0 22,3M19,15.59L17.59,17L14,13.41L10.41,17L9,15.59L12.59,12L9,8.41L10.41,7L14,10.59L17.59,7L19,8.41L15.41,12"/>
                            </Button>
                        </UniformGrid>
                    </Grid>

                    <!-- Step 4: what the machine learned, in the same plain words as the list. -->
                    <StackPanel IsVisible="{Binding IsDone, ElementName=PageHost}"
                                VerticalAlignment="Center" Spacing="28">
                        <PathIcon Width="90" Height="90" Foreground="#3FBF7F" HorizontalAlignment="Center"
                                  Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"/>
                        <TextBlock Classes="StepTitle" Text="Fatto"/>
                        <TextBlock Classes="StepBody" Text="{Binding DoneLabel, ElementName=PageHost}"/>
                        <Button Classes="PrimaryBtn" Width="360" HorizontalAlignment="Center" Click="OnCloseDone">
                            <TextBlock Text="CHIUDI" Foreground="{StaticResource TextPrimary}"
                                       FontSize="{StaticResource FontBody}" FontWeight="Bold"
                                       FontFamily="Space Grotesk" LetterSpacing="1"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Canvas>
</UserControl>
