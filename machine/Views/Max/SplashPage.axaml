<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="DaevaMini.Views.Max.SplashPage">

    <UserControl.Styles>
        <Style Selector="Button.ChromeButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Padding="{TemplateBinding Padding}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.ChromeButton:pressed">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="Button.StatusButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#353535"/>
        </Style>
        <Style Selector="Button.UnlockButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.UnlockButton:pressed">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.UnlockButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- Slow breath on the wordmark: alive, but not as insistent as the alerts. -->
        <Style Selector="Image.LogoPulse">
            <Style.Animations>
                <Animation Duration="0:0:3.2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.45"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="TextBlock.LogoPulse">
            <Style.Animations>
                <Animation Duration="0:0:3.2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.45"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Canvas Width="1920" Height="1080">
        <Canvas.Background>
            <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="80%" RadiusY="80%">
                <GradientStop Color="#1A2222" Offset="0"/>
                <GradientStop Color="#0B0D0D" Offset="1"/>
            </RadialGradientBrush>
        </Canvas.Background>

        <StackPanel Canvas.Left="60" Canvas.Top="40" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="ClockText"
                       Text="14:28"
                       Foreground="#E7E6DC"
                       FontSize="36"
                       FontWeight="Medium"
                       FontFamily="Space Grotesk"/>

            <Rectangle Width="1" Height="20" Fill="#E7E6DC" Opacity="0.3" Margin="15,0" VerticalAlignment="Center"/>

            <TextBlock Text="TURIN, IT"
                       Foreground="#CAF0F8"
                       FontSize="18"
                       FontWeight="Bold"
                       FontFamily="Space Grotesk"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <Border Canvas.Left="1592"
                Canvas.Top="40"
                Width="200"
                Height="48"
                Background="#2D2D2D"
                BorderBrush="#404040"
                BorderThickness="1"
                CornerRadius="24">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Ellipse Name="StatusDot" Width="10" Height="10" Fill="#10B981" Margin="0,0,10,0"/>

                <TextBlock Name="StatusText"
                           Text="PRONTA"
                           Foreground="#E7E6DC"
                           FontSize="14"
                           FontWeight="Bold"
                           FontFamily="Space Grotesk"
                           LetterSpacing="2"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Button Classes="ChromeButton StatusButton"
                Canvas.Left="1812"
                Canvas.Top="40"
                Width="48"
                Height="48"
                Background="#2D2D2D"
                BorderBrush="#404040"
                BorderThickness="1"
                CornerRadius="24"
                Cursor="Hand"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Click="OnSettingsClick">
            <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                      Foreground="#E7E6DC" Opacity="0.8" Width="22" Height="22"/>
        </Button>

        <Image Classes="LogoPulse"
               Canvas.Left="680"
               Canvas.Top="480"
               Width="560"
               Height="120"
               Stretch="Uniform"
               Source="avares://Daeva/Assets/DaevaWhite.png">
            <Image.Effect>
                <DropShadowEffect BlurRadius="25" Color="#CAF0F8" Opacity="0.6"/>
            </Image.Effect>
        </Image>

        <TextBlock Classes="LogoPulse"
                   Canvas.Left="1252"
                   Canvas.Top="534"
                   Text="max"
                   Foreground="#CAF0F8"
                   FontSize="42"
                   FontWeight="Bold"
                   FontFamily="Space Grotesk">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="20" Color="#CAF0F8" Opacity="0.8"/>
            </TextBlock.Effect>
        </TextBlock>

        <Button Name="TouchToStartButton"
                Classes="ChromeButton UnlockButton"
                Canvas.Left="700"
                Canvas.Top="930"
                Width="520"
                Height="140"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Click="OnTouchToStart">
            <StackPanel HorizontalAlignment="Center">
                <Rectangle Width="150" Height="2" Fill="#E7E6DC" Opacity="0.3" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <PathIcon Width="20" Height="20"
                              Foreground="#E7E6DC"
                              Opacity="0.6"
                              Margin="0,0,10,0"
                              Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.11,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8H17V6A5,5 0 0,0 12,1A5,5 0 0,0 7,6V8H6A2,2 0 0,0 4,10V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V10A2,2 0 0,0 18,8M8,6A4,4 0 0,1 12,2A4,4 0 0,1 16,6V8H8V6Z"/>

                    <TextBlock Text="TOCCA PER SBLOCCARE"
                               Foreground="#E7E6DC"
                               Opacity="0.6"
                               FontSize="16"
                               FontWeight="SemiBold"
                               FontFamily="Space Grotesk"
                               LetterSpacing="2"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Button>
    </Canvas>
</UserControl>

