<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="DaevaMini.Views.Max.SettingsDaevaMax">

    <UserControl.Styles>
        <Style Selector="Button.InvisibleBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.InvisibleBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.InvisibleBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="Button.SettingsTile">
            <Setter Property="Background" Value="#0CFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="30,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.SettingsTile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="Button.SettingsTile:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#24FFFFFF"/>
        </Style>
    </UserControl.Styles>

    <Canvas Width="1920" Height="1080">
        <Canvas.Background>
            <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="80%" RadiusY="80%">
                <GradientStop Color="#1A2222" Offset="0"/>
                <GradientStop Color="#0B0D0D" Offset="1"/>
            </RadialGradientBrush>
        </Canvas.Background>

        <Button Canvas.Left="60" Canvas.Top="40" Classes="InvisibleBtn" Click="OnBackClick" Width="220" Height="48">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                <PathIcon Width="20" Height="20" Foreground="{StaticResource TextPrimary}" Margin="0,0,12,0"
                          Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
                <TextBlock Text="INDIETRO" Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FontBody}" FontFamily="Space Grotesk"
                           FontWeight="Bold" LetterSpacing="2" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <TextBlock Canvas.Top="40" Width="1920" Text="IMPOSTAZIONI" Foreground="{StaticResource TextPrimary}"
                   FontSize="{StaticResource FontSection}" FontFamily="Space Grotesk" FontWeight="Bold" LetterSpacing="4"
                   HorizontalAlignment="Center" TextAlignment="Center"/>

        <Border Canvas.Left="260" Canvas.Top="110" Width="1400" Height="880" CornerRadius="32"
                Background="#0AFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1">
            <!-- Two columns rather than one stack: six full-width rows overflowed the
                 panel. Every tile is itself the button - the old APRI / AVVIA pills put
                 a small second target inside a row that was already the thing to press. -->
            <Grid Margin="60,50" ColumnDefinitions="*,24,*" RowDefinitions="150,24,150,24,150,24,150"
                  VerticalAlignment="Center">
                <Button Grid.Row="0" Grid.Column="0" Classes="SettingsTile" Click="OnCocktailsClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="24">
                        <Border Width="60" Height="60" CornerRadius="30" Background="#15FFFFFF">
                            <PathIcon Width="24" Height="24" Foreground="{StaticResource TextPrimary}"
                                      Data="M3,2H21V4H20V8A4,4 0 0,1 16,12H14V20H17V22H7V20H10V12H8A4,4 0 0,1 4,8V4H3V2M6,4V8A2,2 0 0,0 8,10H16A2,2 0 0,0 18,8V4H6Z"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Cocktail" Foreground="{StaticResource TextPrimary}"
                                       FontSize="{StaticResource FontTitle}"
                                       FontFamily="Space Grotesk" FontWeight="Medium"/>
                            <TextBlock Text="Dosi, ricette e creazioni" Foreground="{StaticResource TextMuted}"
                                       FontSize="{StaticResource FontCaption}"
                                       FontFamily="Space Grotesk"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="2" Classes="SettingsTile" Click="OnLiquidsClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="24">
                        <Border Width="60" Height="60" CornerRadius="30" Background="#15FFFFFF">
                            <PathIcon Width="24" Height="24" Foreground="{StaticResource TextPrimary}"
                                      Data="M12,3.25C12,3.25 6,10 6,14C6,17.32 8.69,20 12,20A6,6 0 0,0 18,14C18,10 12,3.25 12,3.25M14.47,9.97L15.53,11.03L9.53,17.03L8.47,15.97M9.75,10A1.25,1.25 0 0,1 11,11.25A1.25,1.25 0 0,1 9.75,12.5A1.25,1.25 0 0,1 8.5,11.25A1.25,1.25 0 0,1 9.75,10M14.25,14.5A1.25,1.25 0 0,1 15.5,15.75A1.25,1.25 0 0,1 14.25,17A1.25,1.25 0 0,1 13,15.75A1.25,1.25 0 0,1 14.25,14.5Z"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Selezione liquidi" Foreground="{StaticResource TextPrimary}"
                                       FontSize="{StaticResource FontTitle}"
                                       FontFamily="Space Grotesk" FontWeight="Medium"/>
                            <TextBlock Text="Cosa contiene ogni linea" Foreground="{StaticResource TextMuted}"
                                       FontSize="{StaticResource FontCaption}"
                                       FontFamily="Space Grotesk"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="0" Classes="SettingsTile" Click="OnFillingClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="24">
                        <Border Width="60" Height="60" CornerRadius="30" Background="#15FFFFFF">
                            <PathIcon Width="24" Height="24" Foreground="{StaticResource TextPrimary}"
                                      Data="M16,10H14V17H11L15,21L19,17H16V10M8,14H10V7H13L9,3L5,7H8V14Z"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Cambio contenitori" Foreground="{StaticResource TextPrimary}"
                                       FontSize="{StaticResource FontTitle}"
                                       FontFamily="Space Grotesk" FontWeight="Medium"/>
                            <TextBlock Text="Riempi bottiglie e fusti" Foreground="{StaticResource TextMuted}"
                                       FontSize="{StaticResource FontCaption}"
                                       FontFamily="Space Grotesk"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="2" Classes="SettingsTile" Click="OnCleaningClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="24">
                        <Border Width="60" Height="60" CornerRadius="30" Background="#15FFFFFF">
                            <PathIcon Width="24" Height="24" Foreground="{StaticResource TextPrimary}"
                                      Data="M12,20A6,6 0 0,1 6,14C6,10 12,3.25 12,3.25C12,3.25 18,10 18,14A6,6 0 0,1 12,20Z"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Risciacquo" Foreground="{StaticResource TextPrimary}"
                                       FontSize="{StaticResource FontTitle}"
                                       FontFamily="Space Grotesk" FontWeight="Medium"/>
                            <TextBlock Text="Lava le linee" Foreground="{StaticResource TextMuted}"
                                       FontSize="{StaticResource FontCaption}"
                                       FontFamily="Space Grotesk"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Grid.Row="4" Grid.Column="0" Classes="SettingsTile" Click="OnFlowRateClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="24">
                        <Border Width="60" Height="60" CornerRadius="30" Background="#15FFFFFF">
                            <PathIcon Width="24" Height="24" Foreground="{StaticResource TextPrimary}"
                                      Data="M12,2A3,3 0 0,0 9,5C9,6.31 9.83,7.42 11,7.83V10H8A2,2 0 0,0 6,12V13H4V19H8V13H6V12H11V19H13V12H18V13H16V19H20V13H18V12A2,2 0 0,0 16,10H13V7.83C14.17,7.42 15,6.31 15,5A3,3 0 0,0 12,2Z"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Velocità dei fusti" Foreground="{StaticResource TextPrimary}"
                                       FontSize="{StaticResource FontTitle}"
                                       FontFamily="Space Grotesk" FontWeight="Medium"/>
                            <TextBlock Text="Misura quanto versano" Foreground="{StaticResource TextMuted}"
                                       FontSize="{StaticResource FontCaption}"
                                       FontFamily="Space Grotesk"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Grid.Row="6" Grid.Column="0" Classes="SettingsTile" Click="OnChangePinClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="24">
                        <Border Width="60" Height="60" CornerRadius="30" Background="#15FFFFFF">
                            <PathIcon Width="24" Height="24" Foreground="{StaticResource TextPrimary}"
                                      Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.11,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8H17V6A5,5 0 0,0 12,1A5,5 0 0,0 7,6V8H6A2,2 0 0,0 4,10V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V10A2,2 0 0,0 18,8M8,6A4,4 0 0,1 12,2A4,4 0 0,1 16,6V8H8V6Z"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="PIN" Foreground="{StaticResource TextPrimary}"
                                       FontSize="{StaticResource FontTitle}"
                                       FontFamily="Space Grotesk" FontWeight="Medium"/>
                            <TextBlock Text="Cambia il codice delle impostazioni" Foreground="{StaticResource TextMuted}"
                                       FontSize="{StaticResource FontCaption}"
                                       FontFamily="Space Grotesk"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Stretch overrides the SettingsTile style's Left content alignment: without
                     it the inner Grid shrinks to its content and the switch sits against the
                     text instead of the card's right edge. -->
                <Button Grid.Row="4" Grid.Column="2" Classes="SettingsTile" Click="OnEventModeToggle"
                        Padding="30,0,20,0" HorizontalContentAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="24">
                            <Border Width="60" Height="60" CornerRadius="30" Background="#15FFFFFF">
                                <PathIcon Width="24" Height="24" Foreground="{StaticResource TextPrimary}"
                                          Data="M5,4H19A2,2 0 0,1 21,6V18A2,2 0 0,1 19,20H5A2,2 0 0,1 3,18V6A2,2 0 0,1 5,4M7,8V16H11V8H7M13,8V16H17V8H13Z"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Attiva fusti" Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FontTitle}"
                                           FontFamily="Space Grotesk" FontWeight="Medium"/>
                                <TextBlock Name="EventModeDetail"
                                           Text="" Foreground="{StaticResource TextMuted}" FontSize="{StaticResource FontCaption}"
                                           FontFamily="Space Grotesk" TextWrapping="Wrap" MaxWidth="300"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- iOS-style switch: a pill track with a circular thumb that slides
                             between two Margin values (ApplyEventMode). One tap target for
                             the whole tile, matching every other SettingsTile in this grid. -->
                        <Border Grid.Column="1" Name="EventModeTrack" Width="84" Height="46" CornerRadius="23"
                                BorderBrush="#33FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                            <Border Name="EventModeThumb" Width="38" Height="38" CornerRadius="19"
                                    HorizontalAlignment="Left">
                                <Border.Transitions>
                                    <Transitions>
                                        <ThicknessTransition Property="Margin" Duration="0:0:0.18"/>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                        </Border>
                    </Grid>
                </Button>
            </Grid>
        </Border>

    </Canvas>
</UserControl>
