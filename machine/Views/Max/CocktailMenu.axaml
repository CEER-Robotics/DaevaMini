<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:DaevaMini.Converters"
             xmlns:models="clr-namespace:DaevaMini.Models"
             xmlns:vm="clr-namespace:DaevaMini.ViewModels"
             xmlns:max="clr-namespace:DaevaMini.Views.Max"
             xmlns:services="clr-namespace:DaevaMini.Services"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="DaevaMini.Views.Max.CocktailMenu"
             x:Name="MenuHost"
             x:DataType="vm:CocktailMenuViewModel">

    <UserControl.Resources>
        <converters:BitmapAssetConverter x:Key="BitmapAssetConverter"/>

                <DataTemplate x:Key="CocktailCardTemplate" x:DataType="max:CocktailCardItem">
                    <!-- The whole card is the target: tapping it opens the drink, and only
                         then does the pour button appear. -->
                    <Button Classes="InvisibleBtn"
                            Margin="15"
                            IsEnabled="{Binding Cocktail.IsActive}"
                            Click="OnPourClick"
                            CommandParameter="{Binding}">
                        <Border Width="400"
                                Height="360"
                                CornerRadius="24"
                                ClipToBounds="True"
                                Background="#1B1C16"
                                Classes="Card"
                                Classes.confirming="{Binding IsConfirming}">
                            <Grid>
                                <Border Background="#020202" IsVisible="{Binding Cocktail.ShowImage}"/>

                                <Image Classes="Art"
                                       Source="{Binding Cocktail.ImageSource, Converter={StaticResource BitmapAssetConverter}}"
                                       IsVisible="{Binding Cocktail.ShowImage}"
                                       Stretch="Uniform"
                                       VerticalAlignment="Top"
                                       Margin="0,26,0,0"/>

                                <Border IsVisible="{Binding !Cocktail.ShowImage}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,30%" EndPoint="0%,100%">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="#EB050505" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Idle: the name sits centred under the artwork. -->
                                <StackPanel VerticalAlignment="Bottom"
                                            HorizontalAlignment="Left"
                                            Margin="24,0,24,24"
                                            IsVisible="{Binding !IsConfirming}">
                                    <TextBlock Text="{Binding Cocktail.Title}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="{StaticResource FontSection}"
                                               FontWeight="Bold"
                                               FontFamily="Space Grotesk"
                                               TextAlignment="Left"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Cocktail.Subtitle}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="{StaticResource FontCaption}"
                                               FontFamily="Space Grotesk"
                                               Margin="0,4,0,0"
                                               TextAlignment="Left"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Selected: name and the ingredient list take the right half. -->
                                <StackPanel Width="196"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,26,20,0"
                                            Spacing="12"
                                            IsVisible="{Binding IsConfirming}">
                                    <TextBlock Text="{Binding Cocktail.Title}"
                                               Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FontTitle}" FontWeight="Bold"
                                               FontFamily="Space Grotesk" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding Cocktail.Ingredients}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:CocktailIngredient">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                               Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FontBody}"
                                                               FontFamily="Space Grotesk"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Milliliters, StringFormat={}{0} ml}"
                                                               Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FontBody}" FontWeight="Bold"
                                                               FontFamily="Space Grotesk"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Spacing="10"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,34"
                                            IsVisible="{Binding IsConfirming}">
                                    <Grid Width="240" Height="76" HorizontalAlignment="Center">
                                        <Border Classes="PourGlow"
                                                Width="220" Height="60" CornerRadius="30"
                                                Background="Transparent"
                                                BoxShadow="0 0 34 0 #CAF0F8"/>
                                        <Button Classes="BigPourBtn"
                                                Width="220"
                                                Height="60"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Click="OnPourConfirmClick" CommandParameter="{Binding}">
                                            <TextBlock Text="EROGA" Foreground="{StaticResource OnAccent}" FontSize="{StaticResource FontLabel}"
                                                       FontWeight="Bold" FontFamily="Space Grotesk" LetterSpacing="3"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="Posiziona il bicchiere qui sotto"
                                               Foreground="{StaticResource Accent}" FontSize="{StaticResource FontBody}" FontWeight="Bold"
                                               FontFamily="Space Grotesk"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <Border Background="#BB121212"
                                        IsHitTestVisible="False"
                                        IsVisible="{Binding Cocktail.IsInactive}"/>
                            </Grid>
                        </Border>
                    </Button>
                </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.InvisibleBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Padding="{TemplateBinding Padding}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.InvisibleBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.InvisibleBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="Button.InvisibleBtn:disabled">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.InvisibleBtn:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- Pouring: the thread carries the accent, the caption stays quiet. -->
        <Style Selector="TextBlock.StatePouring">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="{StaticResource FontLabel}"/>
            <Setter Property="LetterSpacing" Value="8"/>
        </Style>

        <!-- Ready: the line is the message, so it takes the size and the light. -->
        <Style Selector="TextBlock.StateDone">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="{StaticResource FontScreen}"/>
            <Setter Property="LetterSpacing" Value="0"/>
        </Style>

        <Style Selector="TextBlock.PourDone">
            <Setter Property="FontSize" Value="64"/>
            <Setter Property="LetterSpacing" Value="0"/>
            <Setter Property="Foreground" Value="#E7E6DC"/>
        </Style>

        <Style Selector="StackPanel.GlassPrompt">
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="TextBlock.PourBlink">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="LetterSpacing" Value="6"/>
        </Style>

        <Style Selector="StackPanel.PourPulse">
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.2"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="PathIcon.CollectArrow">
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Margin" Value="0,0,0,0"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Margin" Value="0,26,0,0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Margin" Value="0,0,0,0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- The tap button. One control, two states: what it says is what pressing
             it will do, so the guest never has to work out whether it is running. -->
        <!-- The stroke thickness is deliberately the same in both states. A shape's
             stroke is drawn straddling its geometry, so thickening it on open changed
             the circle's real footprint and the button appeared to jump between APRI
             and CHIUDI. Only colour changes now; the geometry never moves. -->
        <Style Selector="Button.TapToggle Ellipse.Body">
            <Setter Property="Fill" Value="#161816"/>
            <Setter Property="Stroke" Value="{StaticResource Accent}"/>
            <Setter Property="StrokeThickness" Value="6"/>
        </Style>
        <Style Selector="Button.TapToggle TextBlock.TapLabel">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>

        <!-- Open: the button takes the colour the strips are showing, so the screen
             and the machine itself are saying the same thing. -->
        <Style Selector="Button.TapToggle.flowing Ellipse.Body">
            <Setter Property="Fill" Value="#FFC828"/>
            <Setter Property="Stroke" Value="#FFE9A0"/>
        </Style>
        <Style Selector="Button.TapToggle.flowing TextBlock.TapLabel">
            <Setter Property="Foreground" Value="#131818"/>
        </Style>

        <!-- Breathes on the same 2.6 s cycle as the LED animation in the firmware, so
             the halo on screen and the strips rise and fall together. -->
        <Style Selector="Ellipse.TapHalo">
            <Style.Animations>
                <Animation Duration="0:0:2.6" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.15"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.6"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.15"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- The warning badge pulses so it is noticeable from across the bar. -->
        <Style Selector="Button.WarningBadge Ellipse">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.25"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Confirming slides the artwork to the left edge and frees the right half
             for the tasting note. -->
        <Style Selector="Image.Art">
            <Setter Property="Width" Value="215"/>
            <Setter Property="Height" Value="215"/>
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Width" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Height" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.Card.confirming Image.Art">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="160"/>
            <Setter Property="RenderTransform" Value="translateX(-114px)"/>
        </Style>

        <Style Selector="Button.MiniConfirmBtn">
            <Setter Property="Background" Value="#CAF0F8"/>
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.MiniConfirmBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B0E5F0"/>
        </Style>
        <Style Selector="Button.MiniCancelBtn">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.MiniCancelBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3DFFFFFF"/>
        </Style>

        <Style Selector="Button.BigPourBtn">
            <Setter Property="Background" Value="#CAF0F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.BigPourBtn /template/ ContentPresenter">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.BigPourBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B0E5F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.BigPourBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#A0D8E5"/>
        </Style>

        <!-- Slow halo behind the pour button: noticeable without competing with the alerts. -->
        <Style Selector="Border.PourGlow">
            <Style.Animations>
                <Animation Duration="0:0:2.6" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.25"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.9"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.25"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Button.QuickPourBtn">
            <Setter Property="Background" Value="#CAF0F8"/>
            <Setter Property="CornerRadius" Value="21"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.QuickPourBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B0E5F0"/>
        </Style>
        <Style Selector="Button.QuickPourBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#A0D8E5"/>
        </Style>

        <Style Selector="Button.ConfirmYesBtn">
            <Setter Property="Background" Value="#CAF0F8"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ConfirmYesBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B0E5F0"/>
        </Style>

        <Style Selector="Button.ConfirmNoBtn">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ConfirmNoBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3DFFFFFF"/>
        </Style>

        <Style Selector="ProgressBar.CardDispenseProgress">
            <Setter Property="Foreground" Value="#CAF0F8"/>
            <Setter Property="Background" Value="#24FFFFFF"/>
            <Setter Property="CornerRadius" Value="21"/>
        </Style>
    </UserControl.Styles>

    <Canvas x:Name="PageSurface" Width="1920" Height="1080">
        <Canvas.Background>
            <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="80%" RadiusY="80%">
                <GradientStop Color="#1A2222" Offset="0"/>
                <GradientStop Color="#0B0D0D" Offset="1"/>
            </RadialGradientBrush>
        </Canvas.Background>

        <Button Name="BackButton"
                Classes="InvisibleBtn"
                Canvas.Left="48"
                Canvas.Top="42"
                Width="52"
                Height="52">
            <PathIcon Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                      Foreground="{StaticResource TextPrimary}"
                      Opacity="0.8"
                      Width="34"
                      Height="34"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
        </Button>

        <Image Canvas.Left="860"
               Canvas.Top="30"
               Width="200"
               Height="60"
               Source="avares://Daeva/Assets/DaevaWhite.png"
               Stretch="Uniform">
            <Image.Effect>
                <DropShadowEffect BlurRadius="20" Color="#CAF0F8" Opacity="0.4"/>
            </Image.Effect>
        </Image>

        <Button Name="WarningButton"
                Classes="InvisibleBtn WarningBadge"
                Canvas.Left="1790"
                Canvas.Top="42"
                Width="52"
                Height="52"
                Cursor="Hand"
                IsVisible="{Binding HasWarnings, ElementName=MenuHost}"
                Click="OnWarningClick">
            <Ellipse Width="16"
                     Height="16"
                     Fill="{Binding WarningAccent, ElementName=MenuHost}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Button>

        <Border Canvas.Left="660"
                Canvas.Top="120"
                Width="600"
                Height="56"
                Background="#161816"
                CornerRadius="28"
                BorderBrush="#2A2C22"
                BorderThickness="1"
                Padding="4">
            <ItemsControl ItemsSource="{Binding Filters, ElementName=MenuHost}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="max:FilterTab">
                        <Button Classes="InvisibleBtn" Click="OnFilterClick" CommandParameter="{Binding}">
                            <Border Background="{Binding Background}" CornerRadius="24">
                                <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}"
                                           FontFamily="Space Grotesk" FontWeight="{Binding FontWeight}" FontSize="{StaticResource FontBody}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Canvas.Left="100"
                Canvas.Top="220"
                Width="1720"
                Height="780"
                ClipToBounds="True">
            <!-- Pages sit shoulder to shoulder on one strip: turning a page slides the
                 strip instead of swapping its contents, the way a phone home screen moves. -->
            <ItemsControl Name="MenuStrip"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="0"
                          ItemsSource="{Binding Pages, ElementName=MenuHost}">
                <ItemsControl.Transitions>
                    <Transitions>
                        <ThicknessTransition Property="Margin" Duration="0:0:0.42" Easing="CubicEaseOut"/>
                    </Transitions>
                </ItemsControl.Transitions>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="max:CocktailPage">
                        <ItemsControl Width="1720" Height="780"
                                      ItemsSource="{Binding Items}"
                                      ItemTemplate="{StaticResource CocktailCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" Rows="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Canvas.Top="1000"
                Width="1920"
                Height="60"
                IsVisible="{Binding IsPagerVisible, ElementName=MenuHost}">
            <ItemsControl ItemsSource="{Binding PageIndicators, ElementName=MenuHost}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="max:PageIndicator">
                        <Button Classes="InvisibleBtn"
                                Width="44"
                                Height="24"
                                CommandParameter="{Binding Index}"
                                Click="OnPageIndicatorClick">
                            <Rectangle Width="{Binding Width}"
                                       Height="4"
                                       Fill="#E7E6DC"
                                       RadiusX="2"
                                       RadiusY="2"
                                       Opacity="{Binding Opacity}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <!-- Pour screen: the glass holds still while the drink rises behind it. One
             animated property (the liquid height) instead of a ring redrawn by hand. -->
        <Border Canvas.Left="0"
                Canvas.Top="0"
                Width="1920"
                Height="1080"
                Background="#F5000000"
                IsVisible="{Binding IsPourOverlayOpen, ElementName=MenuHost}">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="30">
                    <TextBlock Text="{Binding PourTitle, ElementName=MenuHost}"
                               Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FontHero}" FontWeight="Bold"
                               FontFamily="Space Grotesk"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <Image Source="{Binding PourImage, ElementName=MenuHost, Converter={StaticResource BitmapAssetConverter}}"
                           Width="360" Height="360"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"/>

                    <Grid Width="900" Height="6" HorizontalAlignment="Center">
                        <Border Background="#1AFFFFFF" CornerRadius="3"/>
                        <Border Name="ProgressFill"
                                Width="0"
                                HorizontalAlignment="Left"
                                Background="{StaticResource Accent}"
                                CornerRadius="3"
                                BoxShadow="0 0 26 0 #CAF0F8"/>
                    </Grid>

                    <Grid Height="86">
                        <TextBlock Text="{Binding PourMessage, ElementName=MenuHost}"
                                   Classes.StatePouring="{Binding !IsPourDone, ElementName=MenuHost}"
                                   Classes.StateDone="{Binding IsPourDone, ElementName=MenuHost}"
                                   FontWeight="Bold"
                                   FontFamily="Space Grotesk"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Points down at the glass once the pour is finished. -->
                    <Grid Height="96" Width="120" HorizontalAlignment="Center">
                        <PathIcon Classes="CollectArrow"
                                  Data="M11,4H13V16L18.5,10.5L19.92,11.92L12,19.84L4.08,11.92L5.5,10.5L11,16V4Z"
                                  Foreground="{StaticResource Accent}"
                                  Width="64" Height="64"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top"
                                  IsVisible="{Binding IsPourDone, ElementName=MenuHost}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tap screen: drinks that are drawn rather than measured. The guest works
             the valve, so the screen is one big button and nothing else competes
             with it. -->
        <Border Canvas.Left="0"
                Canvas.Top="0"
                Width="1920"
                Height="1080"
                Background="#F5000000"
                IsVisible="{Binding IsTapOverlayOpen, ElementName=MenuHost}">
            <!-- Absolute coordinates, like the rest of these screens, and for a
                 reason here: the label changes width, the hint changes length and the
                 FATTO button comes and goes. In a stack that re-centres itself, any of
                 those would shift the big circle under the guest's finger mid-pour.
                 Every element owns a fixed slot instead, so nothing can move anything
                 else. -->
            <Canvas Width="1920" Height="1080">
                <TextBlock Canvas.Left="0" Canvas.Top="150"
                           Width="1920" Height="110"
                           Text="{Binding TapTitle, ElementName=MenuHost}"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="{StaticResource FontHero}" FontWeight="Bold"
                           FontFamily="Space Grotesk"
                           TextAlignment="Center"/>

                <!-- 440 wide, centred on 1920: (1920-440)/2 = 740. -->
                <Grid Canvas.Left="740" Canvas.Top="300" Width="440" Height="440">
                    <!-- Only while pouring: a halo that makes it obvious from across
                         the room that the valve is open. It sits behind the button and
                         takes no layout space, so appearing moves nothing. -->
                    <Ellipse Classes="TapHalo"
                             Width="440" Height="440"
                             Fill="#FFC828"
                             IsVisible="{Binding IsTapFlowing, ElementName=MenuHost}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Button Classes="InvisibleBtn TapToggle"
                            Classes.flowing="{Binding IsTapFlowing, ElementName=MenuHost}"
                            Width="360" Height="360"
                            CornerRadius="180"
                            Click="OnTapToggleClick"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <Ellipse Classes="Body" Width="360" Height="360"/>
                            <!-- Fills the circle and centres inside it, so APRI and
                                 CHIUDI occupy the same box despite different widths. -->
                            <TextBlock Classes="TapLabel"
                                       Width="360" Height="90"
                                       Text="{Binding TapButtonLabel, ElementName=MenuHost}"
                                       FontSize="72" FontWeight="Bold"
                                       FontFamily="Space Grotesk"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </Grid>

                <!-- Fixed height: the hint is one line in one state and could wrap in
                     another, and a taller line must not push anything. -->
                <TextBlock Canvas.Left="0" Canvas.Top="800"
                           Width="1920" Height="70"
                           Text="{Binding TapHint, ElementName=MenuHost}"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="{StaticResource FontTitle}"
                           FontFamily="Space Grotesk"
                           TextAlignment="Center"/>

                <!-- Hidden while pouring: leaving is not a thing to do with the valve
                     open, and the button would only invite it. Its slot stays reserved
                     either way. -->
                <Button Canvas.Left="830" Canvas.Top="900"
                        Classes="InvisibleBtn"
                        Width="260" Height="64" CornerRadius="32"
                        Background="#1AFFFFFF"
                        Click="OnTapDoneClick"
                        IsVisible="{Binding !IsTapFlowing, ElementName=MenuHost}">
                    <TextBlock Text="FATTO"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="{StaticResource FontLabel}" FontWeight="Bold"
                               FontFamily="Space Grotesk"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Canvas>
        </Border>

        <Border Canvas.Left="0"
                Canvas.Top="0"
                Width="1920"
                Height="1080"
                Background="#E6000000"
                IsVisible="{Binding IsWarningPanelOpen, ElementName=MenuHost}">
            <Border Width="900"
                    MaxHeight="700"
                    Background="#161816"
                    BorderBrush="#2A2C22"
                    BorderThickness="1"
                    CornerRadius="32"
                    Padding="48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="0,0,0,28">
                        <Ellipse Width="16" Height="16"
                                 Fill="{Binding WarningAccent, ElementName=MenuHost}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Avvisi"
                                   Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FontSection}" FontWeight="Bold"
                                   FontFamily="Space Grotesk" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom"
                            Classes="ConfirmNoBtn"
                            Width="200" Height="56"
                            Margin="0,28,0,0"
                            HorizontalAlignment="Center"
                            Click="OnWarningPanelClose">
                        <TextBlock Text="CHIUDI" Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FontBody}" FontWeight="Bold"
                                   FontFamily="Space Grotesk"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Warnings, ElementName=MenuHost}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:MachineWarning">
                                    <Border Background="#1F211C" CornerRadius="16" Padding="24,18" Margin="0,0,0,12">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <Ellipse Width="12" Height="12" Fill="{Binding Accent}"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{Binding Accent}" FontSize="{StaticResource FontLabel}" FontWeight="Bold"
                                                           FontFamily="Space Grotesk" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{StaticResource TextMuted}" FontSize="{StaticResource FontCaption}"
                                                       FontFamily="Space Grotesk" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Canvas>
</UserControl>
