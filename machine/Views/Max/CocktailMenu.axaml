<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:DaevaMini.Converters"
             xmlns:models="clr-namespace:DaevaMini.Models"
             xmlns:vm="clr-namespace:DaevaMini.ViewModels"
             xmlns:max="clr-namespace:DaevaMini.Views.Max"
             xmlns:services="clr-namespace:DaevaMini.Services"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="DaevaMini.Views.Max.CocktailMenu"
             x:Name="MenuHost"
             x:DataType="vm:CocktailMenuViewModel">

    <UserControl.Resources>
        <converters:BitmapAssetConverter x:Key="BitmapAssetConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.InvisibleBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Padding="{TemplateBinding Padding}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.InvisibleBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.InvisibleBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="Button.InvisibleBtn:disabled">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.InvisibleBtn:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="TextBlock.PourDone">
            <Setter Property="FontSize" Value="64"/>
            <Setter Property="LetterSpacing" Value="0"/>
            <Setter Property="Foreground" Value="#E7E6DC"/>
        </Style>

        <Style Selector="StackPanel.GlassPrompt">
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="TextBlock.PourBlink">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="LetterSpacing" Value="6"/>
        </Style>

        <Style Selector="StackPanel.PourPulse">
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.2"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="PathIcon.CollectArrow">
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Margin" Value="0,0,0,0"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Margin" Value="0,26,0,0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Margin" Value="0,0,0,0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- The warning badge pulses so it is noticeable from across the bar. -->
        <Style Selector="Button.WarningBadge Ellipse">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.25"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Confirming slides the artwork to the left edge and frees the right half
             for the tasting note. -->
        <Style Selector="Image.Art">
            <Setter Property="Width" Value="215"/>
            <Setter Property="Height" Value="215"/>
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Width" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Height" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.Card.confirming Image.Art">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="160"/>
            <Setter Property="RenderTransform" Value="translateX(-114px)"/>
        </Style>

        <Style Selector="Button.MiniConfirmBtn">
            <Setter Property="Background" Value="#CAF0F8"/>
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.MiniConfirmBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B0E5F0"/>
        </Style>
        <Style Selector="Button.MiniCancelBtn">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.MiniCancelBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3DFFFFFF"/>
        </Style>

        <Style Selector="Button.QuickPourBtn">
            <Setter Property="Background" Value="#CAF0F8"/>
            <Setter Property="CornerRadius" Value="21"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.QuickPourBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B0E5F0"/>
        </Style>
        <Style Selector="Button.QuickPourBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#A0D8E5"/>
        </Style>

        <Style Selector="Button.ConfirmYesBtn">
            <Setter Property="Background" Value="#CAF0F8"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ConfirmYesBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B0E5F0"/>
        </Style>

        <Style Selector="Button.ConfirmNoBtn">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ConfirmNoBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3DFFFFFF"/>
        </Style>

        <Style Selector="ProgressBar.CardDispenseProgress">
            <Setter Property="Foreground" Value="#CAF0F8"/>
            <Setter Property="Background" Value="#24FFFFFF"/>
            <Setter Property="CornerRadius" Value="21"/>
        </Style>
    </UserControl.Styles>

    <Canvas x:Name="PageSurface" Width="1920" Height="1080">
        <Canvas.Background>
            <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="80%" RadiusY="80%">
                <GradientStop Color="#1A2222" Offset="0"/>
                <GradientStop Color="#0B0D0D" Offset="1"/>
            </RadialGradientBrush>
        </Canvas.Background>

        <Button Name="BackButton"
                Classes="InvisibleBtn"
                Canvas.Left="48"
                Canvas.Top="42"
                Width="52"
                Height="52">
            <PathIcon Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                      Foreground="#E7E6DC"
                      Opacity="0.8"
                      Width="34"
                      Height="34"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
        </Button>

        <Image Canvas.Left="860"
               Canvas.Top="30"
               Width="200"
               Height="60"
               Source="avares://Daeva/Assets/DaevaWhite.png"
               Stretch="Uniform">
            <Image.Effect>
                <DropShadowEffect BlurRadius="20" Color="#CAF0F8" Opacity="0.4"/>
            </Image.Effect>
        </Image>

        <Button Name="WarningButton"
                Classes="InvisibleBtn WarningBadge"
                Canvas.Left="1790"
                Canvas.Top="42"
                Width="52"
                Height="52"
                Cursor="Hand"
                IsVisible="{Binding HasWarnings, ElementName=MenuHost}"
                Click="OnWarningClick">
            <Ellipse Width="16"
                     Height="16"
                     Fill="{Binding WarningAccent, ElementName=MenuHost}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Button>

        <Border Canvas.Left="660"
                Canvas.Top="120"
                Width="600"
                Height="56"
                Background="#161816"
                CornerRadius="28"
                BorderBrush="#2A2C22"
                BorderThickness="1"
                Padding="4">
            <ItemsControl ItemsSource="{Binding Filters, ElementName=MenuHost}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="max:FilterTab">
                        <Button Classes="InvisibleBtn" Click="OnFilterClick" CommandParameter="{Binding}">
                            <Border Background="{Binding Background}" CornerRadius="24">
                                <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}"
                                           FontFamily="Space Grotesk" FontWeight="{Binding FontWeight}" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <ItemsControl Canvas.Left="100"
                      Canvas.Top="220"
                      Width="1720"
                      Height="780"
                      ItemsSource="{Binding VisibleCocktails, ElementName=MenuHost}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" Rows="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="max:CocktailCardItem">
                    <Border Width="400"
                            Height="360"
                            Margin="15"
                            CornerRadius="24"
                            ClipToBounds="True"
                            Background="#1B1C16"
                            Classes="Card"
                            Classes.confirming="{Binding IsConfirming}">
                            <Grid>
                                <!-- Artwork is opt-in per cocktail (ShowImage in appsettings)
                                     while the restyle pass is in progress. The artwork PNGs carry
                                     their own black background, so the card matches it and skips
                                     the gradient. -->
                                <Border Background="#020202" IsVisible="{Binding Cocktail.ShowImage}"/>

                                <Image Classes="Art"
                                       Source="{Binding Cocktail.ImageSource, Converter={StaticResource BitmapAssetConverter}}"
                                       IsVisible="{Binding Cocktail.ShowImage}"
                                       Stretch="Uniform"
                                       VerticalAlignment="Top"
                                       Margin="0,26,0,0"/>

                                <Border IsVisible="{Binding !Cocktail.ShowImage}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,30%" EndPoint="0%,100%">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="#EB050505" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <StackPanel VerticalAlignment="Bottom" Margin="24"
                                            HorizontalAlignment="Left"
                                            Width="224"
                                            IsVisible="{Binding !IsConfirming}">
                                    <TextBlock Text="{Binding Cocktail.Title}"
                                               Foreground="#E7E6DC"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               FontFamily="Space Grotesk"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Cocktail.Subtitle}"
                                               Foreground="#A0A0A0"
                                               FontSize="14"
                                               FontFamily="Space Grotesk"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Quick pour: tapping asks for confirmation first, then the
                                     progress bar replaces the button in place. -->
                                <Button Classes="QuickPourBtn"
                                        IsVisible="{Binding IsPourButtonVisible}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,20,20"
                                        Width="132"
                                        Height="42"
                                        Click="OnPourClick"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="EROGA" Foreground="#000000" FontSize="13"
                                               FontWeight="Bold" FontFamily="Space Grotesk" LetterSpacing="1"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <ProgressBar Classes="CardDispenseProgress"
                                             IsVisible="{Binding IsPouring}"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Bottom"
                                             Margin="0,0,20,20"
                                             Width="132"
                                             Height="42"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding Progress}"/>

                                <!-- Shown for a few seconds once the pour completes. -->
                                <Border Background="#E6000000" IsVisible="{Binding IsCompleted}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
                                        <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M10,17L5,12L6.41,10.59L10,14.17L17.59,6.58L19,8L10,17Z"
                                                  Foreground="#CAF0F8" Width="46" Height="46"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Text="Ritira il tuo cocktail"
                                                   Foreground="#E7E6DC" FontSize="22" FontWeight="Bold"
                                                   FontFamily="Space Grotesk" TextWrapping="Wrap"
                                                   TextAlignment="Center" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Tasting note, revealed by the artwork sliding aside. -->
                                <StackPanel Width="196"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,24,20,0"
                                            Spacing="10"
                                            IsVisible="{Binding IsConfirming}">
                                    <TextBlock Text="{Binding Cocktail.Title}"
                                               Foreground="#E7E6DC" FontSize="24" FontWeight="Bold"
                                               FontFamily="Space Grotesk" TextWrapping="Wrap"
                                               TextAlignment="Left"/>
                                    <TextBlock Text="{Binding Cocktail.Description}"
                                               Foreground="#A0A0A0" FontSize="15" LineHeight="21"
                                               FontFamily="Space Grotesk" TextWrapping="Wrap"
                                               TextAlignment="Left"/>
                                </StackPanel>

                                <!-- Confirmation sits where START POUR was. -->
                                <StackPanel Spacing="10"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,22"
                                            IsVisible="{Binding IsConfirming}">
                                    <TextBlock Text="{Binding Cocktail.DoseSummary}"
                                               Width="380"
                                               Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"
                                               FontFamily="Space Grotesk"
                                               TextWrapping="NoWrap"
                                               TextAlignment="Center"
                                               Margin="0,0,0,6"/>
                                    <StackPanel Classes="GlassPrompt"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="Posiziona il bicchiere qui sotto"
                                                   Foreground="#CAF0F8" FontSize="18" FontWeight="Bold"
                                                   FontFamily="Space Grotesk"
                                                   VerticalAlignment="Center"/>
                                        <PathIcon Data="M11,4H13V16L18.5,10.5L19.92,11.92L12,19.84L4.08,11.92L5.5,10.5L11,16V4Z"
                                                  Foreground="#CAF0F8"
                                                  Width="20" Height="20"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Classes="QuickPourBtn"
                                            Width="132"
                                            Height="42"
                                            HorizontalAlignment="Center"
                                            Click="OnPourConfirmClick" CommandParameter="{Binding}">
                                        <TextBlock Text="EROGA" Foreground="#000000" FontSize="13"
                                                   FontWeight="Bold" FontFamily="Space Grotesk" LetterSpacing="1"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>

                        <Border Background="#BB121212"
                                IsHitTestVisible="False"
                                IsVisible="{Binding Cocktail.IsInactive}"/>
                    </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Canvas.Top="1000"
                Width="1920"
                Height="60"
                IsVisible="{Binding IsPagerVisible, ElementName=MenuHost}">
            <ItemsControl ItemsSource="{Binding PageIndicators, ElementName=MenuHost}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="max:PageIndicator">
                        <Button Classes="InvisibleBtn"
                                Width="44"
                                Height="24"
                                CommandParameter="{Binding Index}"
                                Click="OnPageIndicatorClick">
                            <Rectangle Width="{Binding Width}"
                                       Height="4"
                                       Fill="#E7E6DC"
                                       RadiusX="2"
                                       RadiusY="2"
                                       Opacity="{Binding Opacity}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <!-- Pour theatre: the drink under a closing progress ring, then the collect message. -->
        <Border Canvas.Left="0"
                Canvas.Top="0"
                Width="1920"
                Height="1080"
                Background="#F2000000"
                IsVisible="{Binding IsPourOverlayOpen, ElementName=MenuHost}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="34">
                <Grid Width="520" Height="520" HorizontalAlignment="Center">
                    <Ellipse Width="500" Height="500"
                             Stroke="#1FFFFFFF" StrokeThickness="16"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Arc Width="500" Height="500"
                         StartAngle="-90"
                         SweepAngle="{Binding PourSweepAngle, ElementName=MenuHost}"
                         IsVisible="{Binding !IsPourDone, ElementName=MenuHost}"
                         Stroke="#CAF0F8" StrokeThickness="16" StrokeLineCap="Round"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Ellipse Width="500" Height="500"
                             IsVisible="{Binding IsPourDone, ElementName=MenuHost}"
                             Stroke="#CAF0F8" StrokeThickness="16"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Image Source="{Binding PourImage, ElementName=MenuHost, Converter={StaticResource BitmapAssetConverter}}"
                           Width="300" Height="300"
                           Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <Grid Height="126">
                    <TextBlock Text="{Binding PourTitle, ElementName=MenuHost}"
                               IsVisible="{Binding !IsPourDone, ElementName=MenuHost}"
                               Foreground="#E7E6DC" FontSize="96" FontWeight="Bold"
                               FontFamily="Space Grotesk"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <Grid Height="92" Margin="0,-34,0,0">
                <StackPanel Classes="PourPulse"
                            Orientation="Horizontal" Spacing="20"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding PourMessage, ElementName=MenuHost}"
                               Classes.PourBlink="{Binding !IsPourDone, ElementName=MenuHost}"
                               Classes.PourDone="{Binding IsPourDone, ElementName=MenuHost}"
                               Foreground="#CAF0F8" FontWeight="Bold"
                               FontFamily="Space Grotesk"
                               VerticalAlignment="Bottom"/>
                    <TextBlock Text="{Binding PourBigName, ElementName=MenuHost}"
                               IsVisible="{Binding IsPourDone, ElementName=MenuHost}"
                               Foreground="#FFFFFF" FontSize="64" FontWeight="Bold"
                               FontFamily="Space Grotesk"
                               VerticalAlignment="Bottom"/>
                </StackPanel>
                </Grid>

                <!-- Points down at the glass once the pour is finished. -->
                <Grid Height="104" Width="120" HorizontalAlignment="Center">
                    <PathIcon Classes="CollectArrow"
                              Data="M11,4H13V16L18.5,10.5L19.92,11.92L12,19.84L4.08,11.92L5.5,10.5L11,16V4Z"
                              Foreground="#CAF0F8"
                              Width="72" Height="72"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              IsVisible="{Binding IsPourDone, ElementName=MenuHost}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Canvas.Left="0"
                Canvas.Top="0"
                Width="1920"
                Height="1080"
                Background="#E6000000"
                IsVisible="{Binding IsWarningPanelOpen, ElementName=MenuHost}">
            <Border Width="900"
                    MaxHeight="700"
                    Background="#161816"
                    BorderBrush="#2A2C22"
                    BorderThickness="1"
                    CornerRadius="32"
                    Padding="48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="0,0,0,28">
                        <Ellipse Width="16" Height="16"
                                 Fill="{Binding WarningAccent, ElementName=MenuHost}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Avvisi"
                                   Foreground="#E7E6DC" FontSize="30" FontWeight="Bold"
                                   FontFamily="Space Grotesk" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom"
                            Classes="ConfirmNoBtn"
                            Width="200" Height="56"
                            Margin="0,28,0,0"
                            HorizontalAlignment="Center"
                            Click="OnWarningPanelClose">
                        <TextBlock Text="CHIUDI" Foreground="#E7E6DC" FontSize="18" FontWeight="Bold"
                                   FontFamily="Space Grotesk"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Warnings, ElementName=MenuHost}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:MachineWarning">
                                    <Border Background="#1F211C" CornerRadius="16" Padding="24,18" Margin="0,0,0,12">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <Ellipse Width="12" Height="12" Fill="{Binding Accent}"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{Binding Accent}" FontSize="20" FontWeight="Bold"
                                                           FontFamily="Space Grotesk" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="#A0A0A0" FontSize="15"
                                                       FontFamily="Space Grotesk" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Canvas>
</UserControl>
