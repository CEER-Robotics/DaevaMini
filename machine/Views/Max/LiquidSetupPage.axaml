            <Grid Width="140" Height="140">
                <Path Data="M 5,0 H 9 A 1,1 0 0 1 10,1 V 6 A 4,4 0 0 0 14,10 V 28 A 2,2 0 0 1 12,30 H 2 A 2,2 0 0 1 0,28 V 10 A 4,4 0 0 0 4,6 V 1 A 1,1 0 0 1 5,0 Z" Fill="Transparent" Stroke="#E7E6DC" StrokeThickness="2" Stretch="Uniform" Width="16" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </ToggleButton>

