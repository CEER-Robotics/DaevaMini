<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:DaevaMini.Controls"
             xmlns:max="clr-namespace:DaevaMini.Views.Max"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="DaevaMini.Views.Max.LiquidSetupPage"
             x:Name="LiquidHost">

    <UserControl.Styles>
        <Style Selector="Button.InvisibleBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.InvisibleBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.InvisibleBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <Style Selector="ToggleButton.BottleBtn">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="220"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Spacing="0">
                        <Grid Width="200" Height="180" Background="Transparent">
                            <Border Name="GlowRing" Width="140" Height="140" CornerRadius="70"
                                    BorderThickness="4" BorderBrush="#CAF0F8" Opacity="0"
                                    BoxShadow="0 0 25 0 #CAF0F8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Name="InnerBg" Width="140" Height="140" CornerRadius="70"
                                    Background="#161816" ClipToBounds="True"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                        </Grid>
                        <TextBlock Name="OuterText" Text="{TemplateBinding Tag}" Foreground="{StaticResource TextMuted}"
                                   FontFamily="Space Grotesk" FontSize="{StaticResource FontBody}" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,-25,0,0"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.BottleBtn:checked /template/ Border#InnerBg">
            <Setter Property="Background" Value="#2A3030"/>
        </Style>
        <Style Selector="ToggleButton.BottleBtn:checked /template/ Border#GlowRing">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ToggleButton.BottleBtn:checked /template/ TextBlock#OuterText">
            <Setter Property="Foreground" Value="#CAF0F8"/>
        </Style>
        <Style Selector="ToggleButton.BottleBtn.Filled /template/ Border#InnerBg">
            <Setter Property="Background" Value="#223033"/>
        </Style>
        <Style Selector="ToggleButton.BottleBtn.Filled /template/ TextBlock#OuterText">
            <Setter Property="Foreground" Value="#CAF0F8"/>
        </Style>
        <Style Selector="ToggleButton.BottleBtn:disabled">
            <Setter Property="Opacity" Value="0.3"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>

        <Style Selector="ToggleButton.JerryCanBtn">
            <Setter Property="Width" Value="280"/>
            <Setter Property="Height" Value="300"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Spacing="0" Background="Transparent">
                        <Grid Width="280" Height="250" Background="Transparent">
                            <Border Name="KegGlow" Width="200" Height="200" CornerRadius="28"
                                    BorderThickness="4" BorderBrush="#CAF0F8" Opacity="0"
                                    BoxShadow="0 0 25 0 #CAF0F8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Name="KegFrame" Width="200" Height="200" CornerRadius="28" BorderBrush="#2A2C22"
                                    BorderThickness="1" ClipToBounds="True"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Name="KegTop" Grid.Row="0" Background="#1B1C16"/>
                                    <Border Name="KegBottom" Grid.Row="1" Background="#161816"/>
                                    <ContentPresenter Grid.RowSpan="2" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <TextBlock Name="KegText" Text="{TemplateBinding Tag}" Foreground="{StaticResource TextPrimary}"
                                   FontFamily="Space Grotesk"
                                   FontSize="{StaticResource FontTitle}" FontWeight="Bold" HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.JerryCanBtn:checked /template/ Border#KegGlow">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ToggleButton.JerryCanBtn:checked /template/ Border#KegTop">
            <Setter Property="Background" Value="#2A3030"/>
        </Style>
        <Style Selector="ToggleButton.JerryCanBtn:checked /template/ Border#KegBottom">
            <Setter Property="Background" Value="#243033"/>
        </Style>
        <Style Selector="ToggleButton.JerryCanBtn:checked /template/ TextBlock#KegText">
            <Setter Property="Foreground" Value="#CAF0F8"/>
        </Style>
        <Style Selector="ToggleButton.JerryCanBtn.Filled /template/ Border#KegTop">
            <Setter Property="Background" Value="#223033"/>
        </Style>
        <Style Selector="ToggleButton.JerryCanBtn.Filled /template/ TextBlock#KegText">
            <Setter Property="Foreground" Value="#CAF0F8"/>
        </Style>
        <Style Selector="ToggleButton.JerryCanBtn:disabled">
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>

        <Style Selector="Button.DoneButtonStyle">
            <Setter Property="Width" Value="360"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Width="360" Height="120" Background="Transparent">
                        <Border Name="DoneBorder" Width="300" Height="80" CornerRadius="40"
                                Background="#2A3030" BorderBrush="#CAF0F8" BorderThickness="3"
                                BoxShadow="0 0 30 0 #CAF0F8"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold"
                                       FontFamily="Space Grotesk" Foreground="{StaticResource Accent}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.DoneButtonStyle:disabled">
            <Setter Property="Opacity" Value="0.3"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>
        <!-- The pencil is the only thing to press on this page, so it is given a real
             target rather than an icon floating on the container. -->
        <Style Selector="Button.EditLineBtn">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Background" Value="#212418"/>
            <Setter Property="BorderBrush" Value="#3A3D33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.EditLineBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A3030"/>
        </Style>
        <Style Selector="Button.EditLineBtn:disabled">
            <Setter Property="Opacity" Value="0.3"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>

        <Style Selector="Button.LiquidBtn">
            <Setter Property="Height" Value="84"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#0CFFFFFF"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.LiquidBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
    </UserControl.Styles>

    <Canvas Width="1920" Height="1080">
        <Canvas.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#0E100C" Offset="0"/>
                <GradientStop Color="#141712" Offset="1"/>
            </LinearGradientBrush>
        </Canvas.Background>

        <Button Canvas.Left="60" Canvas.Top="40" Classes="InvisibleBtn" Click="OnBackClick" Width="220" Height="48">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                <PathIcon Width="20" Height="20" Foreground="{StaticResource TextPrimary}" Margin="0,0,12,0"
                          Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
                <TextBlock Text="INDIETRO" Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FontBody}"
                           FontFamily="Space Grotesk" FontWeight="Bold" LetterSpacing="2" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <TextBlock Canvas.Top="40" Width="1920" Text="SELEZIONE LIQUIDI"
                   Foreground="{StaticResource TextPrimary}"
                   FontSize="{StaticResource FontSection}" FontWeight="Bold"
                   FontFamily="Space Grotesk" TextAlignment="Center"/>

        <ToggleButton IsHitTestVisible="False" x:Name="Keg1" Classes="JerryCanBtn" Tag="11" Canvas.Left="120" Canvas.Top="240">
            <PathIcon Width="62" Height="62" Foreground="{StaticResource TextPrimary}"
                      Data="M224 88C224 74.7 234.7 64 248 64L328 64C341.3 64 352 74.7 352 88L352 112L360 112C373.3 112 384 122.7 384 136C384 149.3 373.3 160 360 160L216 160C202.7 160 192 149.3 192 136C192 122.7 202.7 112 216 112L224 112L224 88zM128 320C128 249.3 185.3 192 256 192L384 192C454.7 192 512 249.3 512 320L512 512C512 547.3 483.3 576 448 576L192 576C156.7 576 128 547.3 128 512L128 320zM384 320L384 416C384 433.7 398.3 448 416 448C433.7 448 448 433.7 448 416L448 320C448 302.3 433.7 288 416 288C398.3 288 384 302.3 384 320z"/>
        </ToggleButton>

