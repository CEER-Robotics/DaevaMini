        <Button Classes="EditLineBtn" Tag="1" Canvas.Left="678" Canvas.Top="686"
                Click="OnEditLine">
            <PathIcon Width="24" Height="24" Foreground="{StaticResource TextPrimary}"
                      Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
        </Button>
        <Button Classes="EditLineBtn" Tag="10" Canvas.Left="1338" Canvas.Top="686"
                Click="OnEditLine">
            <PathIcon Width="24" Height="24" Foreground="{StaticResource TextPrimary}"
                      Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
        </Button>
        <Button x:Name="KegEdit1" Classes="EditLineBtn" Tag="11" Canvas.Left="334" Canvas.Top="248"
                Click="OnEditLine">
            <PathIcon Width="24" Height="24" Foreground="{StaticResource TextPrimary}"
                      Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
        </Button>
        <Button x:Name="KegEdit2" Classes="EditLineBtn" Tag="12" Canvas.Left="334" Canvas.Top="548"
                Click="OnEditLine">
            <PathIcon Width="24" Height="24" Foreground="{StaticResource TextPrimary}"
                      Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
        </Button>
        <Button x:Name="KegEdit3" Classes="EditLineBtn" Tag="13" Canvas.Left="1734" Canvas.Top="248"
                Click="OnEditLine">
            <PathIcon Width="24" Height="24" Foreground="{StaticResource TextPrimary}"
                      Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
        </Button>
        <Button x:Name="KegEdit4" Classes="EditLineBtn" Tag="14" Canvas.Left="1734" Canvas.Top="548"
                Click="OnEditLine">
            <PathIcon Width="24" Height="24" Foreground="{StaticResource TextPrimary}"
                      Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
        </Button>

        <!-- Kegs off: the same red cross used on the refill page, so the two screens
     read alike. ApplyKegAvailability also blanks the label underneath, leaving
     this message in its place instead of stacking two captions. -->
        <Grid Name="Keg1Blocked"
              Canvas.Left="120"
              Canvas.Top="240"
              Width="280"
              Height="300"
              IsHitTestVisible="False"
              IsVisible="False">
            <Line StartPoint="46,32" EndPoint="234,218"
                  Stroke="#E5484D" StrokeThickness="6" StrokeLineCap="Round" Opacity="0.75"/>
            <TextBlock Text="Non disponibili in questa modalità"
                       Foreground="{StaticResource Danger}" FontSize="{StaticResource FontCaption}" FontWeight="Bold"
                       FontFamily="Space Grotesk" TextWrapping="Wrap" TextAlignment="Center"
                       Width="240"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,6"/>
        </Grid>
        <Grid Name="Keg2Blocked"
              Canvas.Left="120"
              Canvas.Top="540"
              Width="280"
              Height="300"
              IsHitTestVisible="False"
              IsVisible="False">
            <Line StartPoint="46,32" EndPoint="234,218"
                  Stroke="#E5484D" StrokeThickness="6" StrokeLineCap="Round" Opacity="0.75"/>
            <TextBlock Text="Non disponibili in questa modalità"
                       Foreground="{StaticResource Danger}" FontSize="{StaticResource FontCaption}" FontWeight="Bold"
                       FontFamily="Space Grotesk" TextWrapping="Wrap" TextAlignment="Center"
                       Width="240"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,6"/>
        </Grid>
        <Grid Name="Keg3Blocked"
              Canvas.Left="1520"
              Canvas.Top="240"
              Width="280"
              Height="300"
              IsHitTestVisible="False"
              IsVisible="False">
            <Line StartPoint="46,32" EndPoint="234,218"
                  Stroke="#E5484D" StrokeThickness="6" StrokeLineCap="Round" Opacity="0.75"/>
            <TextBlock Text="Non disponibili in questa modalità"
                       Foreground="{StaticResource Danger}" FontSize="{StaticResource FontCaption}" FontWeight="Bold"
                       FontFamily="Space Grotesk" TextWrapping="Wrap" TextAlignment="Center"
                       Width="240"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,6"/>
        </Grid>
        <Grid Name="Keg4Blocked"
              Canvas.Left="1520"
              Canvas.Top="540"
              Width="280"
              Height="300"
              IsHitTestVisible="False"
              IsVisible="False">
            <Line StartPoint="46,32" EndPoint="234,218"
                  Stroke="#E5484D" StrokeThickness="6" StrokeLineCap="Round" Opacity="0.75"/>
            <TextBlock Text="Non disponibili in questa modalità"
                       Foreground="{StaticResource Danger}" FontSize="{StaticResource FontCaption}" FontWeight="Bold"
                       FontFamily="Space Grotesk" TextWrapping="Wrap" TextAlignment="Center"
                       Width="240"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,6"/>
        </Grid>

        <!-- Full-width band across the bottom of the screen. The containers occupy
             y=80..860 and the kegs end at 790, so this is the one region that is
             genuinely free; the previous box sat in the middle of the plan and covered
             the bottles. Status on the left, what is missing on the right. -->
        <Border Canvas.Left="60" Canvas.Top="880" Width="1800" Height="170"
                CornerRadius="24" Padding="32,20"
                Background="{Binding SummaryBackground, ElementName=LiquidHost}"
                BorderBrush="{Binding SummaryBorder, ElementName=LiquidHost}"
                BorderThickness="1">
            <Grid ColumnDefinitions="640,*">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding SummaryHeadline, ElementName=LiquidHost}"
                               Foreground="{Binding SummaryAccent, ElementName=LiquidHost}"
                               FontSize="{StaticResource FontTitle}" FontWeight="Bold"
                               FontFamily="Space Grotesk"/>
                    <TextBlock Text="{Binding SummaryDetail, ElementName=LiquidHost}"
                               Foreground="{StaticResource TextMuted}" FontSize="{StaticResource FontBody}"
                               FontFamily="Space Grotesk" TextWrapping="Wrap"/>
                    <TextBlock Text="Tocca la matita su un contenitore per cambiarne il contenuto."
                               Foreground="{StaticResource TextMuted}" FontSize="{StaticResource FontCaption}"
                               FontFamily="Space Grotesk" Opacity="0.75"/>
                </StackPanel>

                <ScrollViewer Grid.Column="1"
                              controls:DragScroll.Enabled="True"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="24,0,0,0">
                    <ItemsControl ItemsSource="{Binding MissingLiquids, ElementName=LiquidHost}"
                                  Margin="0,0,16,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="max:MissingLiquid">
                                <!-- One line per liquid: the band is short, so the name
                                     and who wants it sit side by side rather than
                                     stacked. -->
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="{StaticResource FontLabel}" FontWeight="Bold"
                                               FontFamily="Space Grotesk"/>
                                    <TextBlock Text="{Binding Detail}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="{StaticResource FontCaption}"
                                               FontFamily="Space Grotesk" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Liquid picker, over everything: while a line is being reassigned nothing
             else on this page should be reachable. -->
        <Border Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080"
                Background="#F2000000"
                IsVisible="{Binding IsPickerOpen, ElementName=LiquidHost}">
            <Canvas Width="1920" Height="1080">
                <TextBlock Canvas.Left="0" Canvas.Top="110" Width="1920" Height="70"
                           Text="{Binding PickerTitle, ElementName=LiquidHost}"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="{StaticResource FontSection}" FontWeight="Bold"
                           FontFamily="Space Grotesk" TextAlignment="Center"/>
                <TextBlock Canvas.Left="0" Canvas.Top="180" Width="1920" Height="46"
                           Text="{Binding PickerSubtitle, ElementName=LiquidHost}"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="{StaticResource FontBody}"
                           FontFamily="Space Grotesk" TextAlignment="Center"/>

                <Border Canvas.Left="610" Canvas.Top="250" Width="700" Height="620"
                        CornerRadius="28" Background="#0AFFFFFF"
                        BorderBrush="#15FFFFFF" BorderThickness="1" Padding="24">
                    <ScrollViewer controls:DragScroll.Enabled="True"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Liquids, ElementName=LiquidHost}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="LiquidBtn" Click="OnPickLiquid"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontSize="{StaticResource FontTitle}"
                                                   FontFamily="Space Grotesk"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Button Canvas.Left="610" Canvas.Top="900" Width="330" Height="72"
                        Classes="LiquidBtn" Click="OnClearLine">
                    <TextBlock Text="SVUOTA LINEA" Foreground="{StaticResource TextMuted}"
                               FontSize="{StaticResource FontBody}" FontWeight="Bold"
                               FontFamily="Space Grotesk" VerticalAlignment="Center"/>
                </Button>
                <Button Canvas.Left="980" Canvas.Top="900" Width="330" Height="72"
                        Classes="LiquidBtn" Click="OnClosePicker">
                    <TextBlock Text="ANNULLA" Foreground="{StaticResource TextPrimary}"
                               FontSize="{StaticResource FontBody}" FontWeight="Bold"
                               FontFamily="Space Grotesk" VerticalAlignment="Center"/>
                </Button>
            </Canvas>
        </Border>
    </Canvas>
</UserControl>
