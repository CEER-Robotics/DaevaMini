        <Button Classes="EditLineBtn" Tag="8" Canvas.Left="1338" Canvas.Top="286"
                Click="OnEditLine">
            <PathIcon Width="24" Height="24" Foreground="{StaticResource TextPrimary}"
                      Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
        </Button>
        <Button Classes="EditLineBtn" Tag="2" Canvas.Left="678" Canvas.Top="486"
                Click="OnEditLine">
            <PathIcon Width="24" Height="24" Foreground="{StaticResource TextPrimary}"
                      Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
        </Button>
        <Button Classes="EditLineBtn" Tag="9" Canvas.Left="1338" Canvas.Top="486"
                Click="OnEditLine">
            <PathIcon Width="24" Height="24" Foreground="{StaticResource TextPrimary}"
