<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DaevaMini.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="600"
        x:Class="DaevaMini.Views.Mini.LockScreen"
        x:DataType="vm:ModesViewModel"
        Background="#131818">

    <UserControl.Styles>
        <Style Selector="Button#StartButton:pointerover">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button#StartButton:pressed">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        
        <Border Background="{Binding CurrentModeColor}" 
                CornerRadius="30" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Top" 
                Margin="0,30,0,0"
                Padding="45,12">
            <TextBlock Text="{Binding CurrentModeName}" 
                       Foreground="#111111" 
                       FontSize="26" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <Image Source="/Assets/DaevaMiniLogo.png" 
               Width="800"
               Stretch="Uniform"
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"
               Margin="0,0,0,60"/> 

        <Button Name="StartButton"
                Content="Touch to start"
                Width="550"
                Height="90"
                CornerRadius="15,15,0,0"
                Background="{Binding CurrentModeColor}"
                Foreground="#111111"
                FontSize="32"
                FontWeight="Medium"
                HorizontalAlignment="Center" 
                VerticalAlignment="Bottom"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Cursor="Hand"
                Margin="0"/>

        <Button Name="SettingsButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="50" Height="50"
                Margin="0,25,20,0"
                Background="Transparent"
                Cursor="Hand">
            <Button.Styles>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="#20FFFFFF"/>
                </Style>
            </Button.Styles>
            <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                      Foreground="#888888" Width="24" Height="24"/>
        </Button>
        
    </Grid>
</UserControl>
