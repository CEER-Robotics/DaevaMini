<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DaevaMini.Converters"
             x:Class="DaevaMini.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <!-- Converters -->
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        <converters:BitmapAssetConverter x:Key="BitmapAssetConverter"/>
        
        <!-- Color Resources -->
        <Color x:Key="PrimaryBackgroundColor">#131818</Color>
        <Color x:Key="SecondaryBackgroundColor">#2A2A2A</Color>
        <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
        <Color x:Key="TextSecondaryColor">#888888</Color>
        <Color x:Key="HoverOverlayColor">#33FFFFFF</Color>
        <Color x:Key="CardBackgroundColor">#3A3A3A</Color>
        
        <!-- Design tokens: every screen reads its colours and type sizes from here.
             Changing the accent, or the whole type scale, is a single edit. -->
        <Color x:Key="TextPrimaryColorToken">#E7E6DC</Color>
        <Color x:Key="TextMutedColorToken">#8A8F80</Color>
        <Color x:Key="AccentColorToken">#CAF0F8</Color>
        <Color x:Key="OnAccentColorToken">#131818</Color>
        <Color x:Key="DangerColorToken">#E5484D</Color>
        <Color x:Key="WarningColorToken">#F5C518</Color>
        <Color x:Key="OkColorToken">#7FE0A8</Color>

        <!-- Top-bar chrome. Every control in the strip across the top of a screen - back,
             the shortcuts, the status pill, the warning badge - is this one material, so
             the bar reads as a bar and not as a row of unrelated buttons. Green-tinted
             dark to sit in the same family as the cards (#1B1C16) and the filter bar. -->
        <Color x:Key="ChromeSurfaceColorToken">#161816</Color>
        <Color x:Key="ChromeSurfaceHoverColorToken">#20231F</Color>
        <Color x:Key="ChromeSurfacePressedColorToken">#2A2E27</Color>
        <Color x:Key="ChromeBorderColorToken">#2A2C22</Color>
        <Color x:Key="ChromeBorderHoverColorToken">#3C4034</Color>

        <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColorToken}"/>
        <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColorToken}"/>
        <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColorToken}"/>
        <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColorToken}"/>
        <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColorToken}"/>
        <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColorToken}"/>
        <SolidColorBrush x:Key="Ok" Color="{StaticResource OkColorToken}"/>

        <SolidColorBrush x:Key="ChromeSurface" Color="{StaticResource ChromeSurfaceColorToken}"/>
        <SolidColorBrush x:Key="ChromeSurfaceHover" Color="{StaticResource ChromeSurfaceHoverColorToken}"/>
        <SolidColorBrush x:Key="ChromeSurfacePressed" Color="{StaticResource ChromeSurfacePressedColorToken}"/>
        <SolidColorBrush x:Key="ChromeBorder" Color="{StaticResource ChromeBorderColorToken}"/>
        <SolidColorBrush x:Key="ChromeBorderHover" Color="{StaticResource ChromeBorderHoverColorToken}"/>

        <x:Double x:Key="FontCaption">14</x:Double>
        <x:Double x:Key="FontBody">17</x:Double>
        <x:Double x:Key="FontLabel">20</x:Double>
        <x:Double x:Key="FontTitle">24</x:Double>
        <x:Double x:Key="FontSection">32</x:Double>
        <x:Double x:Key="FontScreen">48</x:Double>
        <x:Double x:Key="FontHero">86</x:Double>

        <!-- Brush Resources -->
        <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}"/>
        <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="HoverOverlayBrush" Color="{StaticResource HoverOverlayColor}"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Daeva/Styles/AppStyles.axaml"/>
        <StyleInclude Source="avares://Daeva/Styles/CocktailCardStyles.axaml"/>
    </Application.Styles>
</Application>