<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DaevaMini.Converters"
             x:Class="DaevaMini.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <!-- Converters -->
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        <converters:BitmapAssetConverter x:Key="BitmapAssetConverter"/>
        
        <!-- Color Resources -->
        <Color x:Key="PrimaryBackgroundColor">#131818</Color>
        <Color x:Key="SecondaryBackgroundColor">#2A2A2A</Color>
        <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
        <Color x:Key="TextSecondaryColor">#888888</Color>
        <Color x:Key="HoverOverlayColor">#33FFFFFF</Color>
        <Color x:Key="CardBackgroundColor">#3A3A3A</Color>
        
        <!-- Brush Resources -->
        <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}"/>
        <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="HoverOverlayBrush" Color="{StaticResource HoverOverlayColor}"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Daeva/Styles/AppStyles.axaml"/>
        <StyleInclude Source="avares://Daeva/Styles/CocktailCardStyles.axaml"/>
    </Application.Styles>
</Application>